# ==============================================================================
# Pramana-V1 Environment Configuration Template (Phase 03)
# Project: Pramana-V1 ("Every Alert. Backed by Evidence.")
# Team: Unknown GenZ
# Strictly placeholder values for local development and documentation.
# NEVER commit real service keys, JWT secrets, or production passwords.
# ==============================================================================

# Next.js Application Core
NEXT_PUBLIC_APP_NAME="Pramana-V1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Supabase PostgreSQL & Storage Configuration (Phase 03)
# Public Client Keys (Safe for browser bundle, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key-with-public-rls-restricted-scope"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="placeholder-publishable-key"

# Privileged Server-Only Key (STRICTLY ISOLATED TO SERVER-SIDE SERVICES)
# Never import or reference this variable in client components or browser bundles.
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key-for-isolated-server-execution-only"

# Supabase Storage Bucket Names
NEXT_PUBLIC_STORAGE_BUCKET_CLINICAL_DOCS="clinical-documents"
NEXT_PUBLIC_STORAGE_BUCKET_EXTRACTED="extracted-artifacts"
NEXT_PUBLIC_STORAGE_BUCKET_DISCHARGE="discharge-exports"

# Google Gemini API (Server-only, strictly private)
GEMINI_API_KEY="placeholder-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"
